import { describe, it, expect, vi, beforeEach } from 'vitest';
import { encrypt, decrypt } from '../../../src/lib/encrypt.js';

// Mock crypto
vi.mock('crypto', () => ({
  default: {
    randomBytes: vi.fn(),
    createCipheriv: vi.fn(),
    createDecipheriv: vi.fn(),
  },
}));

import crypto from 'crypto';

describe('encrypt', () => {
  const mockRandomBytes = vi.mocked(crypto.randomBytes);
  const mockCreateCipheriv = vi.mocked(crypto.createCipheriv);
  const mockCreateDecipheriv = vi.mocked(crypto.createDecipheriv);

  beforeEach(() => {
    vi.clearAllMocks();
    // Reset environment
    delete process.env.ENCRYPTION_KEY;
  });
    it('should return null for null input', () => {
      const result = decrypt(null);
      expect(result).toBeNull();
    });

    it('should return null for undefined input', () => {
      const result = decrypt(undefined);
      expect(result).toBeNull();
    });

    it('should return null for empty string input', () => {
      const result = decrypt('');
      expect(result).toBeNull();
    });

    it('should return plaintext if not prefixed with "enc:"', () => {
      const plaintext = 'not encrypted';
      const result = decrypt(plaintext);
      expect(result).toBe(plaintext);
    });

    it('should return ciphertext if ENCRYPTION_KEY is not set', () => {
      const ciphertext = 'enc:someencrypteddata';
      const result = decrypt(ciphertext);
      expect(result).toBe(ciphertext);
    });

    it('should return ciphertext if ENCRYPTION_KEY is invalid', () => {
      process.env.ENCRYPTION_KEY = 'invalid';
      const ciphertext = 'enc:someencrypteddata';
      const result = decrypt(ciphertext);
      expect(result).toBe(ciphertext);
    });

    it('should return ciphertext if encrypted data is too short', () => {
      process.env.ENCRYPTION_KEY = 'a'.repeat(64);
      const ciphertext = 'enc:short';
      const result = decrypt(ciphertext);
      expect(result).toBe(ciphertext);
    });

    it('should decrypt valid encrypted data', () => {
      process.env.ENCRYPTION_KEY = 'a'.repeat(64);
      const plaintext = 'test data';
      const iv = Buffer.from('testiv123456');
      const authTag = Buffer.from('authtag12345678');
      const encrypted = Buffer.from('encrypted');

      // Create the encrypted buffer as it would be stored
      const encryptedBuffer = Buffer.concat([iv, authTag, encrypted]);
      const ciphertext = 'enc:' + encryptedBuffer.toString('base64');

      const mockDecipher = {
        update: vi.fn().mockReturnValue(plaintext),
        final: vi.fn().mockReturnValue(''),
        setAuthTag: vi.fn().mockReturnThis(),
      };
      mockCreateDecipheriv.mockReturnValue(mockDecipher as any);

      const result = decrypt(ciphertext);

      expect(mockCreateDecipheriv).toHaveBeenCalledWith('aes-256-gcm', expect.any(Buffer), iv);
      expect(mockDecipher.setAuthTag).toHaveBeenCalledWith(authTag);
      expect(mockDecipher.update).toHaveBeenCalledWith(encrypted);
      expect(mockDecipher.final).toHaveBeenCalledWith('utf8');
      expect(result).toBe(plaintext);
    });

    it('should return ciphertext on decryption error', () => {
      process.env.ENCRYPTION_KEY = 'a'.repeat(64);
      const ciphertext = 'enc:invalidbase64';

      const result = decrypt(ciphertext);

      expect(result).toBe(ciphertext);
    });

    it('should return ciphertext if decipher throws', () => {
      process.env.ENCRYPTION_KEY = 'a'.repeat(64);
      const iv = Buffer.from('testiv123456');
      const authTag = Buffer.from('authtag12345678');
      const encrypted = Buffer.from('encrypted');
      const encryptedBuffer = Buffer.concat([iv, authTag, encrypted]);
      const ciphertext = 'enc:' + encryptedBuffer.toString('base64');

      const mockDecipher = {
        update: vi.fn().mockImplementation(() => { throw new Error('Decryption failed'); }),
        final: vi.fn(),
        setAuthTag: vi.fn().mockReturnThis(),
      };
      mockCreateDecipheriv.mockReturnValue(mockDecipher as any);

      const result = decrypt(ciphertext);

      expect(result).toBe(ciphertext);
    });
  });
});
});